{
    "name": "yasin_tgh/laravel-postman",
    "description": "A powerful package to automatically generate Postman collections from your Laravel routes with intelligent organization and rich documentation capabilities.",
    "type": "library",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.2|^8.0"
    },
    "autoload": {
        "psr-4": {
            "YasinTgh\\LaravelPostman\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YasinTgh\\LaravelPostman\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "yasin taghavi",
            "email": "mrtqvi@yahoo.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "YasinTgh\\LaravelPostman\\PostmanServiceProvider"
            ],
            "logo": "https://i.imgur.com/wt0yMs7.png"
        }
    },
    "license": "MIT",
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
